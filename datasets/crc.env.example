# Copy to an ignored file such as config/feng.strict-production.env or
# config/zeller.strict-production.env. Never commit the edited file.

# Pinned strict paired-host-removal checkout.
METASHOTGUNPREP_ROOT=/path/to/MetaShotgunPrep-strict
METASHOTGUNPREP_COMMIT=a717a105d56934e205c21ef59a316b8613b6d1c1
UPSTREAM_SIF=/path/to/taxonomic-tools_1.0.0.sif
ANALYSIS_SIF=/path/to/crc-spike-maaslin2_1.0.0.sif
HOST_INDEX=/path/to/bowtie2/Homo_sapiens_GRCh38

PREPROCESS_THREADS=8
K2_THREADS=8
MPA_THREADS=8
PROFILE_CONCURRENCY=1
MIN_POST_QC_PAIRS=1

KRAKEN2_DB=/path/to/kraken2/uhgg_v2.0.2
METAPHLAN_DB=/path/to/metaphlan/vJan25_database
METAPHLAN_INDEX=mpa_vJan25_CHOCOPhlAnSGB_202503
READ_LEN=100
BRACKEN_THRESHOLD=10

# Cohort-specific, fresh production locations.
CRC_SCRATCH_ROOT=/path/to/disposable/cohort/scratch
CRC_STATE_DIR=/path/to/persistent/cohort/state
PERSISTENT_QC_ROOT=/path/to/persistent/cohort/qc
PERSISTENT_RESULTS_ROOT=/path/to/persistent/cohort/results

# The independent manifest is generated beside production_manifest.tsv and
# contains exactly the frozen 10/10/10 nested subset.
INDEPENDENT_MANIFEST=/path/to/cohort/production_manifest.independent.tsv

# Shared frozen spike assets and parameters.
SPIKE_ENV=/path/to/frozen/spikein.env
YACHIDA_POOLS_DIR=/path/to/finalized/spike_pools_readlen100_cov2000
FASTQ_ASSEMBLY_MODE=gzip_members

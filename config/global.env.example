# Copy this file to config/global.env and replace every /path/to value.
# config/global.env is intentionally ignored because paths are host-specific.

SIF=/path/to/taxonomic-tools.sif
BIND=/path/to/data:/path/to/data,/path/to/databases:/path/to/databases

K2_DB=/path/to/kraken2/database
K2_THREADS=16
K2_MEM=64
READ_LEN=100

MPA_DB=/path/to/metaphlan/database
MPA_THREADS=8
MPA_MEM=60

USE_KRAKEN=1
USE_METAPHLAN=1

KEEP_KRAKEN_OUT=0
KEEP_KRAKEN_REPORT=0
KEEP_BRACKEN_GENUS=0
KEEP_READ_LEVEL=0
KEEP_QC=0
KEEP_OPEN_CLOSED=1

KEEP_MAPOUT=0

# Optional scheduler settings.
SLURM_PARTITION=
SLURM_ACCOUNT=
SLURM_QCHECK_SECS=20
BATCH_SIZE=5


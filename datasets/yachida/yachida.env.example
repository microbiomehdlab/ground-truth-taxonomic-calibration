# Copy to a local ignored file, for example config/yachida.env, and edit paths.
# Never commit the edited file.

# MetaShotgunPrep checkout and pinned revision used for this validation.
METASHOTGUNPREP_ROOT=/path/to/MetaShotgunPrep
METASHOTGUNPREP_COMMIT=5923619824799457e89bd78b211ed481b7cb6f3f
# Source-built repository images. Configure paths locally after running
# build_reproducibility_containers.sh.
UPSTREAM_SIF=/path/to/taxonomic-tools_1.0.0.sif
ANALYSIS_SIF=/path/to/crc-spike-maaslin2_1.0.0.sif

# Bowtie2 host-index prefix (omit .bt2/.bt2l suffixes).
HOST_INDEX=/path/to/bowtie2/Homo_sapiens_GRCh38
PREPROCESS_THREADS=16

# Exact profiler database release and baseline smoke-test settings.
KRAKEN2_DB=/path/to/kraken2/uhgg_v2.0.2
METAPHLAN_DB=/path/to/metaphlan/vJan25_database
METAPHLAN_INDEX=mpa_vJan25_CHOCOPhlAnSGB_202503
K2_THREADS=16
MPA_THREADS=8
READ_LEN=100
BRACKEN_THRESHOLD=10

# Persistent compact QC/log output. Cleaned FASTQs remain in disposable sample
# scratch and are removed only by stream_sample.py after downstream verification.
PERSISTENT_QC_ROOT=/path/to/persistent/yachida/qc

# Persistent compact profiler/design results and disposable per-sample scratch.
PERSISTENT_RESULTS_ROOT=/path/to/persistent/yachida/results
YACHIDA_SCRATCH_ROOT=/path/to/disposable/yachida/scratch
YACHIDA_STATE_DIR=/path/to/persistent/yachida/state

# Finalized immutable pools may be kept on any sufficiently large readable
# filesystem. Disposable sample scratch should use the fastest available
# high-throughput filesystem.
YACHIDA_POOLS_DIR=/path/to/finalized/spike_pools_readlen100_cov2000
FASTQ_ASSEMBLY_MODE=gzip_members
PROFILE_CONCURRENCY=2

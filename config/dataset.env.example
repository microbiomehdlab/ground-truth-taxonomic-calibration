# Dataset configuration sourced by taxonomy/run_profiling.sh.
DATASET=example_dataset
DATA_DIR=/path/to/fastq_directory
SAMPLES=("sample_001" "sample_002")
PAIRED=true

# Optional explicit paths. Recommended when sample IDs are not FASTQ basenames.
R1=/path/to/sample_001_1.fastq.gz
R2=/path/to/sample_001_2.fastq.gz

# Output location defaults to <repository>/results.
# OUT_ROOT=/path/to/results

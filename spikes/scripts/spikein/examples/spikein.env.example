# Spike-in configuration (example)
# Copy to spikein.env and edit paths.
#
# Required:
IMG=/path/to/taxonomic-tools.sif
WORK=/path/to/spike_work
SAMPLES_TSV=/absolute/path/to/samples.tsv
SPIKE_PANEL=/absolute/path/to/spike_panel.tsv

# Pool settings:
READLEN=150
COVERAGE=2000
THREADS=4

# Spiking settings. Seeds use stable-seed-v1 identifiers and are unaffected by
# sample-manifest order, Slurm array indices, or batch size.
INDEPENDENT_FRACTIONS=0.0001,0.0005,0.001,0.005,0.01,0.05
COMMUNITY_FRACTIONS=0.0001,0.0005,0.001,0.005,0.01,0.05,0.10
SEED_BASE=13

# If your micromamba env has a different name inside the container:
MAMBA_ENV=taxonomic_tools

#!/usr/bin/env bash
#SBATCH -J taxprof.array
#SBATCH --cpus-per-task=4
#SBATCH --mem=10G
#SBATCH -t 12:00:00
#SBATCH -o taxprof_%A_%a.out
#SBATCH -e taxprof_%A_%a.err
#SBATCH --exclude=compute-[1,5,9,13,17,21]  # Exclude bad machines
# Submit with: sbatch --array=1-N taxonomy/run_profiling_array.sbatch

set -euo pipefail

# ---- Config you might tweak ----
SAMPLES_TSV="${SAMPLES_TSV:-samples.tsv}"     # 3 columns: sample_id  fastq1  fastq2
PAIRED_DEFAULT="${PAIRED_DEFAULT:-true}"      # default; we auto-detect below anyway
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${REPO_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
REPO_ROOT="$(cd "$REPO_ROOT" && pwd -P)"
RUNS_DIR="${RUNS_DIR:-runs}"                  # per-sample working dirs live here
# --------------------------------

mkdir -p "${REPO_ROOT}/logs" "${REPO_ROOT}/${RUNS_DIR}"

# Pick Nth (1-based) non-empty, non-comment data row after the header.
LINE=$(awk -v task="$SLURM_ARRAY_TASK_ID" '
  BEGIN {FS="\t"}
  NR == 1 {next}
  NF > 0 && $1 !~ /^#/ {
    i++
    if (i == task) {print; exit}
  }
' "${SAMPLES_TSV}" || true)
if [[ -z "${LINE}" ]]; then
  echo "No data line for index ${SLURM_ARRAY_TASK_ID} in ${SAMPLES_TSV}"
  exit 0
fi

# Parse columns
SAMPLE_ID=$(awk -F'\t' '{print $1}' <<<"${LINE}")
FQ1=$(awk -F'\t' '{print $2}' <<<"${LINE}")
FQ2=$(awk -F'\t' '{print $3}' <<<"${LINE}")

# Derive settings
DATASET="${SAMPLE_ID}"
DATA_DIR="$(dirname "${FQ1}")"
if [[ -n "${FQ2}" && -f "${FQ2}" ]]; then
  PAIRED=true
else
  PAIRED=false
fi

# Create a private working dir for this sample to isolate dataset.env
WORKDIR="${REPO_ROOT}/${RUNS_DIR}/${SAMPLE_ID}"
mkdir -p "${WORKDIR}"
cd "${WORKDIR}"

# Write a per-sample dataset.env.
{
  echo "# Dataset-specific settings generated by run_profiling_array.sbatch"
  printf 'DATASET=%q\n' "$DATASET"
  printf 'DATA_DIR=%q\n' "$DATA_DIR"
  printf 'SAMPLES=(%q)\n' "$SAMPLE_ID"
  printf 'PAIRED=%q\n' "$PAIRED"
  printf 'R1=%q\n' "$FQ1"
  printf 'R2=%q\n' "$FQ2"
} > dataset.env

echo "[info] ${SAMPLE_ID}: dataset.env written in ${WORKDIR}"

echo "[info] PAIRED=${PAIRED}  DATA_DIR=${DATA_DIR}"
echo "[info] FQ1=$(basename "${FQ1}")"
[[ -n "${FQ2:-}" ]] && echo "[info] FQ2=$(basename "${FQ2}")" || true

# Call the profiling pipeline with this sample's generated configuration.
DATASET_ENV="${WORKDIR}/dataset.env" \
ROOT="${REPO_ROOT}" \
bash "${REPO_ROOT}/taxonomy/run_profiling.sh"

Bootstrap: docker
From: mambaorg/micromamba:1.5.6

%labels
    Project Ground-truth-taxonomic-calibration
    Description Pinned preprocessing, spike-generation, and taxonomic-profiling tools

%files
    installation/verify_taxonomic_tools.sh /opt/verify_taxonomic_tools.sh

%post
    set -eux
    export MAMBA_ROOT_PREFIX=/opt/conda
    export HOME=/root
    MAMBA_BIN="$(command -v micromamba || true)"
    if [ -z "$MAMBA_BIN" ]; then
        for candidate in /bin/micromamba /usr/bin/micromamba /usr/local/bin/micromamba; do
            if [ -x "$candidate" ]; then
                MAMBA_BIN="$candidate"
                break
            fi
        done
    fi
    if [ -z "$MAMBA_BIN" ]; then
        echo "[ERROR] micromamba was not found in the base image" >&2
        exit 1
    fi
    echo "[INFO] Using micromamba: $MAMBA_BIN"
    "$MAMBA_BIN" create -y -n taxonomic_tools \
        -c conda-forge -c bioconda \
        python=3.11 \
        kraken2=2.1.6 \
        bracken=3.1 \
        metaphlan=4.2.2 \
        bowtie2=2.5.4 \
        art=2016.06.05 \
        seqtk=1.4 \
        fastqc=0.12.1 \
        fastp=0.23.4 \
        ncbi-datasets-cli=18.29.0
    "$MAMBA_BIN" clean --all --yes
    chmod 0755 /opt/verify_taxonomic_tools.sh
    /opt/verify_taxonomic_tools.sh

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/envs/taxonomic_tools/bin:/bin:/usr/bin:/usr/local/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec /opt/conda/envs/taxonomic_tools/bin/"$@"

%test
    /opt/verify_taxonomic_tools.sh

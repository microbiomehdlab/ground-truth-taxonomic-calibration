# Copy to a private path or spikes/spikein.env and replace /path/to values.
IMG=/path/to/taxonomic-tools.sif
BIND=/path/to/data:/path/to/data,/path/to/references:/path/to/references
WORK=/path/to/spike_work_directory
SAMPLES_TSV=/path/to/samples.tsv
SPIKE_PANEL=/path/to/spike_panel.tsv

POOLS_DIR=/path/to/spike_work_directory/pools_readlen100_cov2000
READLEN=100
COVERAGE=2000
FRAGMEAN=350
FRAGSD=10
THREADS=8

# Final read-pair fractions used in the paper.
INDEPENDENT_FRACTIONS=0.0001,0.0005,0.001,0.005,0.01,0.05
COMMUNITY_FRACTIONS=0.0001,0.0005,0.001,0.005,0.01,0.05,0.10
SEED_BASE=13
# Seeds are derived from stable sample/taxon/fraction identifiers. They do not
# depend on manifest row number, Slurm array index, or processing batch size.
MAX_CONCURRENT=5
SAMPLING_MODE=legacy
MAMBA_ENV=taxonomic_tools

# Copy to a local ignored file, for example config/yachida.env, and edit paths.
# Never commit the edited file.

# MetaShotgunPrep checkout and pinned revision used for this validation.
METASHOTGUNPREP_ROOT=/path/to/MetaShotgunPrep
METASHOTGUNPREP_COMMIT=f218de06a2275f9691aa74bfaf5c8b4153110777
METASHOTGUNPREP_PYTHON=python3

# Source-built repository images. Configure paths locally after running
# build_reproducibility_containers.sh.
UPSTREAM_SIF=/path/to/taxonomic-tools_1.0.0.sif
ANALYSIS_SIF=/path/to/crc-spike-maaslin2_1.0.0.sif

# Bowtie2 host-index prefix (omit .bt2/.bt2l suffixes).
HOST_INDEX=/path/to/bowtie2/Homo_sapiens_GRCh38
PREPROCESS_THREADS=16

# Persistent compact QC/log output. Cleaned FASTQs remain in disposable sample
# scratch and are removed only by stream_sample.py after downstream verification.
PERSISTENT_QC_ROOT=/path/to/persistent/yachida/qc
